[mysqld]
# Disable binary log
# https://mariadb.com/kb/en/library/overview-of-the-binary-log/
# The purpose of the binary log is to allow replication, where data is sent from one or more 
# masters to one or more slave servers based on the contents of the binary log, as well as 
# assisting in backup operations.

skip-log-bin

